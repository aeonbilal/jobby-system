# PII never enters this repo. ./candidates is your own private tracker
# (a directory or a symlink). The engine ships tracker-template/ instead.
/candidates

# scratch, scrape caches, agent worktrees
tmp/
.firecrawl/
.claude/worktrees/

# OS / Python
.DS_Store
__pycache__/
*.pyc

# secrets and machine-local config (API keys: Firecrawl, Apollo, Apify, Prospeo)
.env
.env.*
!.env.example
secrets/
*.local.*
*.pem
*.key
credentials*.json
